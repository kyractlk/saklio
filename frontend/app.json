{
  "expo": {
    "name": "Saklio",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saklio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.ownershipos.gkk7dy",
      "infoPlist": {
        "NSCameraUsageDescription": "Fişlerini taramak için kamera erişimi",
        "NSPhotoLibraryUsageDescription": "Fiş ve ürün fotoğraflarını seçmek için"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F7F2"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.ownershipos.gkk7dy",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F2"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fişlerini taramak için kamera erişimi"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fiş ve ürün fotoğraflarını seçmek için"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8FCFAE"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
