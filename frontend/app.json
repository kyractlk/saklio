{
  "expo": {
    "name": "Saklio",
    "slug": "saklio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saklio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.saklio",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Fişlerini taramak için kamera erişimi",
        "NSPhotoLibraryUsageDescription": "Fiş ve ürün fotoğraflarını seçmek için",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F8F7F2"
      },
      "edgeToEdgeEnabled": true,
      "package": "app.saklio",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F7F2"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fişlerini taramak için kamera erişimi"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fiş ve ürün fotoğraflarını seçmek için"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8FCFAE"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca462c23-e687-4df1-bdf7-ce461fb68463"
      }
    },
    "owner": "kyradam"
  }
}
